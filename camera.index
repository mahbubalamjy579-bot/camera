<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <title>Smart Camera Pro</title>
  <!-- Material Symbols Icons -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

  <style>
    /* Design Tokens & Theme Variables */
    :root {
      --bg-primary: #000000;
      --bg-secondary: #121212;
      --surface: #1e1e1e;
      --text-primary: #ffffff;
      --text-secondary: #a0a0a0;
      --accent: #ffcc00;
      --accent-red: #ff3b30;
      --radius-sm: 8px;
      --radius-full: 50%;
      --bottom-bar-height: 140px;
    }

    body.light-theme {
      --bg-primary: #f2f2f7;
      --bg-secondary: #ffffff;
      --surface: #e5e5ea;
      --text-primary: #000000;
      --text-secondary: #6e6e73;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      overflow: hidden;
      height: 100vh;
      width: 100vw;
    }

    .app-container {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    /* Screens */
    .screen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: var(--bg-primary);
      display: flex;
      flex-direction: column;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
      z-index: 10;
    }

    .screen.active {
      opacity: 1;
      pointer-events: auto;
      z-index: 20;
    }

    /* Top Action Bar */
    .top-bar {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      padding: env(safe-area-inset-top, 16px) 16px 12px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      background: linear-gradient(180deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 100%);
      z-index: 30;
    }

    .icon-btn {
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #fff;
      border-radius: var(--radius-full);
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      backdrop-filter: blur(8px);
    }

    .icon-btn.active {
      color: var(--accent);
      border-color: var(--accent);
    }

    .text-btn {
      font-weight: 600;
      font-size: 0.85rem;
    }

    .text-danger {
      color: var(--accent-red) !important;
    }

    /* Live Viewport */
    .preview-container {
      position: relative;
      flex: 1;
      width: 100%;
      height: 100%;
      background-color: #000;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    #videoPreview {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Grid Lines */
    .grid-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    .grid-line {
      position: absolute;
      background: rgba(255, 255, 255, 0.25);
    }

    .grid-line.h1 { top: 33.33%; width: 100%; height: 1px; }
    .grid-line.h2 { top: 66.66%; width: 100%; height: 1px; }
    .grid-line.v1 { left: 33.33%; width: 1px; height: 100%; }
    .grid-line.v2 { left: 66.66%; width: 1px; height: 100%; }

    /* Countdown & Zoom */
    .countdown-overlay {
      position: absolute;
      font-size: 6rem;
      font-weight: 800;
      color: white;
      text-shadow: 0 4px 12px rgba(0,0,0,0.8);
    }

    .zoom-container {
      position: absolute;
      bottom: calc(var(--bottom-bar-height) + 10px);
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(0,0,0,0.5);
      padding: 6px 14px;
      border-radius: 20px;
      backdrop-filter: blur(8px);
    }

    .zoom-container input[type=range] {
      width: 110px;
      accent-color: var(--accent);
    }

    .recording-badge {
      position: absolute;
      top: 70px;
      background: rgba(255, 0, 0, 0.7);
      padding: 4px 12px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: bold;
    }

    .rec-dot {
      width: 8px;
      height: 8px;
      background: #fff;
      border-radius: var(--radius-full);
      animation: pulse 1s infinite;
    }

    /* Bottom Controls */
    .bottom-bar {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: var(--bottom-bar-height);
      background: linear-gradient(0deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0) 100%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-bottom: env(safe-area-inset-bottom, 20px);
      z-index: 30;
    }

    .mode-selector {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-bottom: 12px;
    }

    .mode-btn {
      font-size: 0.85rem;
      letter-spacing: 1px;
      color: var(--text-secondary);
      font-weight: 600;
      cursor: pointer;
      transition: color 0.2s;
    }

    .mode-btn.active {
      color: var(--accent);
    }

    .shutter-row {
      display: flex;
      align-items: center;
      justify-content: space-around;
      padding: 0 20px 10px;
    }

    .shutter-btn {
      width: 76px;
      height: 76px;
      border-radius: var(--radius-full);
      background: #ffffff;
      border: 4px solid rgba(255, 255, 255, 0.4);
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
      cursor: pointer;
      transition: transform 0.15s ease, background-color 0.2s;
    }

    .shutter-btn:active {
      transform: scale(0.92);
    }

    .shutter-btn.recording {
      background: var(--accent-red);
      border-radius: 18px;
      transform: scale(0.85);
    }

    .gallery-thumb-slot {
      width: 48px;
      height: 48px;
    }

    .gallery-thumb {
      width: 100%;
      height: 100%;
      border-radius: var(--radius-sm);
      background: #333;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #fff;
      overflow: hidden;
      cursor: pointer;
    }

    .gallery-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Gallery Screen */
    .view-header {
      height: 56px;
      padding: 0 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--surface);
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .view-header h2 {
      font-size: 1.1rem;
      font-weight: 600;
    }

    .gallery-grid {
      flex: 1;
      overflow-y: auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 3px;
      padding: 3px;
    }

    .grid-item {
      position: relative;
      aspect-ratio: 1 / 1;
      background: #222;
      cursor: pointer;
      overflow: hidden;
    }

    .grid-item img, .grid-item video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .video-badge {
      position: absolute;
      bottom: 4px;
      right: 4px;
      background: rgba(0, 0, 0, 0.6);
      border-radius: 4px;
      padding: 2px;
      font-size: 16px;
    }

    /* Editor Screen */
    .editor-viewport {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #050505;
      overflow: hidden;
    }

    .editor-media {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      transition: transform 0.2s ease, filter 0.2s ease;
    }

    .edit-toolbar-container {
      background: var(--surface);
      padding: 12px 10px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .filter-strip {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .filter-chip {
      background: rgba(255, 255, 255, 0.1);
      color: var(--text-primary);
      border: none;
      padding: 6px 12px;
      border-radius: 14px;
      white-space: nowrap;
      font-size: 0.8rem;
      cursor: pointer;
    }

    .filter-chip.active {
      background: var(--accent);
      color: #000;
      font-weight: bold;
    }

    .tool-actions {
      display: flex;
      justify-content: space-around;
      gap: 10px;
    }

    .tool-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      background: rgba(255,255,255,0.08);
      color: var(--text-primary);
      border: none;
      padding: 8px;
      border-radius: 6px;
      font-size: 0.8rem;
      cursor: pointer;
    }

    .tool-btn.save-btn {
      background: var(--accent);
      color: #000;
      font-weight: bold;
    }

    /* Modal */
    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      display: flex;
      align-items: flex-end;
      z-index: 100;
    }

    .modal-content {
      width: 100%;
      background: var(--surface);
      border-radius: 16px 16px 0 0;
      padding: 20px;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .setting-item {
      margin-bottom: 16px;
    }

    .setting-item label {
      display: block;
      margin-bottom: 8px;
      font-size: 0.9rem;
    }

    .setting-item select {
      width: 100%;
      padding: 10px;
      border-radius: 8px;
      background: var(--bg-secondary);
      color: var(--text-primary);
      border: 1px solid rgba(255,255,255,0.1);
    }

    .checkbox-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Empty & Error View */
    .empty-state {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      color: var(--text-secondary);
      gap: 12px;
    }

    .empty-state span {
      font-size: 48px;
    }

    .permission-error {
      position: absolute;
      inset: 0;
      background: var(--bg-primary);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 30px;
      text-align: center;
      z-index: 200;
    }

    .err-icon {
      font-size: 64px;
      color: var(--accent-red);
      margin-bottom: 12px;
    }

    .action-btn {
      margin-top: 20px;
      padding: 12px 24px;
      background: var(--accent);
      color: #000;
      font-weight: bold;
      border-radius: 20px;
      border: none;
      cursor: pointer;
    }

    .hidden {
      display: none !important;
    }

    @keyframes pulse {
      0% { opacity: 1; }
      50% { opacity: 0.3; }
      100% { opacity: 1; }
    }
  </style>
</head>
<body class="dark-theme">
  <div class="app-container">
    <!-- Camera Viewport -->
    <main id="cameraScreen" class="screen active">
      <!-- Top Action Bar -->
      <div class="top-bar">
        <button id="btnSettings" class="icon-btn" title="সেটিংস">
          <span class="material-symbols-outlined">settings</span>
        </button>
        <button id="btnFlash" class="icon-btn hidden" title="টর্চ / ফ্ল্যাশ">
          <span class="material-symbols-outlined">flash_on</span>
        </button>
        <button id="btnTimer" class="icon-btn text-btn" title="টাইমার">
          <span id="timerLabel">0s</span>
        </button>
        <button id="btnGrid" class="icon-btn" title="গ্রিড লাইন">
          <span class="material-symbols-outlined">grid_on</span>
        </button>
        <button id="btnSwitchCam" class="icon-btn" title="ক্যামেরা পরিবর্তন">
          <span class="material-symbols-outlined">flip_camera_android</span>
        </button>
      </div>

      <!-- Live Video Viewport -->
      <div class="preview-container">
        <video id="videoPreview" autoplay playsinline muted></video>
        
        <!-- Rule of Thirds Grid Overlay -->
        <div id="gridOverlay" class="grid-overlay hidden">
          <div class="grid-line h1"></div>
          <div class="grid-line h2"></div>
          <div class="grid-line v1"></div>
          <div class="grid-line v2"></div>
        </div>

        <!-- Countdown Display -->
        <div id="countdownOverlay" class="countdown-overlay hidden">3</div>

        <!-- Recording Indicator -->
        <div id="recordingIndicator" class="recording-badge hidden">
          <span class="rec-dot"></span>
          <span id="recTime">00:00</span>
        </div>

        <!-- Zoom Slider -->
        <div id="zoomContainer" class="zoom-container hidden">
          <span class="zoom-label">1x</span>
          <input type="range" id="zoomSlider" min="1" max="5" step="0.1" value="1">
          <span id="zoomValue" class="zoom-value">1.0x</span>
        </div>
      </div>

      <!-- Bottom Controls Area -->
      <div class="bottom-bar">
        <!-- Mode Switcher -->
        <div class="mode-selector">
          <span class="mode-btn active" data-mode="photo">PHOTO</span>
          <span class="mode-btn" data-mode="video">VIDEO</span>
        </div>

        <!-- Shutter & Gallery Row -->
        <div class="shutter-row">
          <div class="gallery-thumb-slot" id="btnOpenGallery">
            <div id="galleryThumbPreview" class="gallery-thumb">
              <span class="material-symbols-outlined">photo_library</span>
            </div>
          </div>

          <button id="shutterBtn" class="shutter-btn photo-mode" aria-label="Capture"></button>

          <div style="width: 48px; height: 48px;"></div>
        </div>
      </div>
    </main>

    <!-- Gallery Screen -->
    <section id="galleryScreen" class="screen">
      <div class="view-header">
        <button id="btnBackFromGallery" class="icon-btn">
          <span class="material-symbols-outlined">arrow_back</span>
        </button>
        <h2>স্মার্ট গ্যালারি</h2>
        <span style="width: 44px;"></span>
      </div>
      <div id="galleryGrid" class="gallery-grid"></div>
      <div id="galleryEmptyState" class="empty-state hidden">
        <span class="material-symbols-outlined">photo_library</span>
        <p>এখনো কোনো ছবি বা ভিডিও ধারণ করা হয়নি</p>
      </div>
    </section>

    <!-- Media Fullscreen / Editor Screen -->
    <section id="editorScreen" class="screen">
      <div class="view-header">
        <button id="btnBackFromEditor" class="icon-btn">
          <span class="material-symbols-outlined">arrow_back</span>
        </button>
        <h2 id="mediaTitle">প্রিভিউ ও এডিট</h2>
        <div style="display: flex; gap: 8px;">
          <button id="btnDownloadCurrent" class="icon-btn">
            <span class="material-symbols-outlined">download</span>
          </button>
          <button id="btnDeleteCurrent" class="icon-btn text-danger">
            <span class="material-symbols-outlined">delete</span>
          </button>
        </div>
      </div>

      <div class="editor-viewport">
        <img id="editorImage" class="editor-media hidden" alt="Preview">
        <video id="editorVideo" class="editor-media hidden" controls playsinline></video>
        <canvas id="editCanvas" class="hidden"></canvas>
      </div>

      <!-- Editing Toolbars (Only for Images) -->
      <div id="imageEditControls" class="edit-toolbar-container">
        <div class="filter-strip">
          <button class="filter-chip active" data-filter="none">Normal</button>
          <button class="filter-chip" data-filter="grayscale(100%)">Grayscale</button>
          <button class="filter-chip" data-filter="sepia(100%)">Sepia</button>
          <button class="filter-chip" data-filter="contrast(150%) brightness(90%)">Vintage</button>
          <button class="filter-chip" data-filter="brightness(130%)">Bright</button>
        </div>

        <div class="tool-actions">
          <button id="btnRotate" class="tool-btn">
            <span class="material-symbols-outlined">rotate_right</span> 90° ঘোরান
          </button>
          <button id="btnAddText" class="tool-btn">
            <span class="material-symbols-outlined">title</span> টেক্সট লিখুন
          </button>
          <button id="btnSaveEdited" class="tool-btn save-btn">
            <span class="material-symbols-outlined">save</span> সেভ করুন
          </button>
        </div>
      </div>
    </section>

    <!-- Settings Modal -->
    <div id="settingsModal" class="modal hidden">
      <div class="modal-content">
        <div class="modal-header">
          <h3>ক্যামেরা সেটিংস</h3>
          <button id="btnCloseSettings" class="icon-btn">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>

        <div class="setting-item">
          <label for="resolutionSelect">ক্যামেরা রেজুলেশন</label>
          <select id="resolutionSelect">
            <option value="high">উচ্চ (FHD / 1080p)</option>
            <option value="medium" selected>মাঝারি (HD / 720p)</option>
            <option value="low">কম (VGA / 480p)</option>
          </select>
        </div>

        <div class="setting-item">
          <label for="themeToggle">অ্যাপ থিম</label>
          <select id="themeToggle">
            <option value="dark" selected>ডার্ক থিম (Dark)</option>
            <option value="light">লাইট থিম (Light)</option>
          </select>
        </div>

        <div class="setting-item checkbox-row">
          <label for="soundToggle">শাটার সাউন্ড ইফেক্ট</label>
          <input type="checkbox" id="soundToggle" checked>
        </div>
      </div>
    </div>

    <!-- Permission Error Screen -->
    <div id="errorScreen" class="permission-error hidden">
      <span class="material-symbols-outlined err-icon">videocam_off</span>
      <h2>ক্যামেরা এক্সেস প্রয়োজন</h2>
      <p id="errorMsg">ক্যামেরা চালু করার জন্য ব্রাউজারের পারমিশন দিন এবং নিশ্চিত করুন আপনার সংযোগটি HTTPS বা Localhost।</p>
      <button id="btnRetryPermission" class="action-btn">আবার চেষ্টা করুন</button>
    </div>
  </div>

  <!-- Application Logic -->
  <script>
    // --- IndexedDB Handler for Offline Media Storage ---
    class CameraDatabase {
      constructor() {
        this.dbName = "SmartCameraDB";
        this.dbVersion = 1;
        this.db = null;
      }

      async init() {
        return new Promise((resolve, reject) => {
          const request = indexedDB.open(this.dbName, this.dbVersion);
          request.onupgradeneeded = (e) => {
            const db = e.target.result;
            if (!db.objectStoreNames.contains("media")) {
              const store = db.createObjectStore("media", { keyPath: "id", autoIncrement: true });
              store.createIndex("timestamp", "timestamp", { unique: false });
            }
          };
          request.onsuccess = (e) => {
            this.db = e.target.result;
            resolve();
          };
          request.onerror = (e) => reject(e);
        });
      }

      async saveMedia(blob, type) {
        return new Promise((resolve, reject) => {
          const tx = this.db.transaction("media", "readwrite");
          const store = tx.objectStore("media");
          const record = { blob, type, timestamp: Date.now() };
          const req = store.add(record);
          req.onsuccess = () => resolve(req.result);
          req.onerror = (e) => reject(e);
        });
      }

      async getAllMedia() {
        return new Promise((resolve, reject) => {
          const tx = this.db.transaction("media", "readonly");
          const store = tx.objectStore("media");
          const req = store.getAll();
          req.onsuccess = () => resolve(req.result.reverse());
          req.onerror = (e) => reject(e);
        });
      }

      async deleteMedia(id) {
        return new Promise((resolve, reject) => {
          const tx = this.db.transaction("media", "readwrite");
          const store = tx.objectStore("media");
          const req = store.delete(Number(id));
          req.onsuccess = () => resolve();
          req.onerror = (e) => reject(e);
        });
      }
    }

    // --- State and UI Variables ---
    const db = new CameraDatabase();

    const state = {
      stream: null,
      facingMode: "environment", // 'user' (Front) or 'environment' (Back)
      mode: "photo",             // 'photo' or 'video'
      isRecording: false,
      mediaRecorder: null,
      recordedChunks: [],
      timerSeconds: 0,
      timerInterval: null,
      activeFilter: "none",
      rotation: 0,
      currentMediaItem: null,
      settings: {
        resolution: "medium",
        sound: true,
        theme: "dark"
      }
    };

    // UI Elements
    const videoPreview = document.getElementById("videoPreview");
    const shutterBtn = document.getElementById("shutterBtn");
    const btnSwitchCam = document.getElementById("btnSwitchCam");
    const btnFlash = document.getElementById("btnFlash");
    const btnTimer = document.getElementById("btnTimer");
    const timerLabel = document.getElementById("timerLabel");
    const btnGrid = document.getElementById("btnGrid");
    const gridOverlay = document.getElementById("gridOverlay");
    const zoomContainer = document.getElementById("zoomContainer");
    const zoomSlider = document.getElementById("zoomSlider");
    const zoomValue = document.getElementById("zoomValue");
    const recordingIndicator = document.getElementById("recordingIndicator");
    const recTimeDisplay = document.getElementById("recTime");
    const countdownOverlay = document.getElementById("countdownOverlay");
    const galleryThumbPreview = document.getElementById("galleryThumbPreview");

    // Screens
    const cameraScreen = document.getElementById("cameraScreen");
    const galleryScreen = document.getElementById("galleryScreen");
    const editorScreen = document.getElementById("editorScreen");
    const errorScreen = document.getElementById("errorScreen");

    // Editor elements
    const editorImage = document.getElementById("editorImage");
    const editorVideo = document.getElementById("editorVideo");
    const editCanvas = document.getElementById("editCanvas");
    const filterChips = document.querySelectorAll(".filter-chip");

    // --- Shutter Sound Generator (Web Audio API) ---
    function playShutterSound() {
      if (!state.settings.sound) return;
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(800, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(400, ctx.currentTime + 0.08);
        gain.gain.setValueAtTime(1, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.09);
      } catch (e) {
        // Fallback silently if blocked
      }
    }

    // --- Camera Stream Lifecycle ---
    async function startCamera() {
      stopCamera();

      const resDimensions = {
        low: { width: { ideal: 640 }, height: { ideal: 480 } },
        medium: { width: { ideal: 1280 }, height: { ideal: 720 } },
        high: { width: { ideal: 1920 }, height: { ideal: 1080 } }
      }[state.settings.resolution];

      const constraints = {
        audio: state.mode === "video",
        video: {
          facingMode: { ideal: state.facingMode },
          ...resDimensions
        }
      };

      try {
        const stream = await navigator.mediaDevices.getUserMedia(constraints);
        state.stream = stream;
        videoPreview.srcObject = stream;
        errorScreen.classList.add("hidden");

        const [videoTrack] = stream.getVideoTracks();
        setupTrackCapabilities(videoTrack);
      } catch (err) {
        console.error("Camera access failed: ", err);
        errorScreen.classList.remove("hidden");
        document.getElementById("errorMsg").innerText = `ক্যামেরা চালু করা যায়নি: ${err.message}`;
      }
    }

    function stopCamera() {
      if (state.stream) {
        state.stream.getTracks().forEach((track) => track.stop());
        state.stream = null;
        videoPreview.srcObject = null;
      }
    }

    function setupTrackCapabilities(track) {
      if (!track || !track.getCapabilities) return;
      const capabilities = track.getCapabilities();

      // Zoom capability
      if (capabilities.zoom) {
        zoomContainer.classList.remove("hidden");
        zoomSlider.min = capabilities.zoom.min;
        zoomSlider.max = capabilities.zoom.max;
        zoomSlider.step = capabilities.zoom.step || 0.1;
        zoomSlider.value = track.getSettings().zoom || 1;
        zoomValue.innerText = `${parseFloat(zoomSlider.value).toFixed(1)}x`;
      } else {
        zoomContainer.classList.add("hidden");
      }

      // Flash/Torch capability
      if (capabilities.torch) {
        btnFlash.classList.remove("hidden");
      } else {
        btnFlash.classList.add("hidden");
      }
    }

    // Zoom Input Slider
    zoomSlider.addEventListener("input", async (e) => {
      const val = parseFloat(e.target.value);
      zoomValue.innerText = `${val.toFixed(1)}x`;
      const [track] = state.stream?.getVideoTracks() || [];
      if (track && track.applyConstraints) {
        await track.applyConstraints({ advanced: [{ zoom: val }] });
      }
    });

    // Flashlight Toggle
    let isTorchOn = false;
    btnFlash.addEventListener("click", async () => {
      const [track] = state.stream?.getVideoTracks() || [];
      if (!track) return;
      try {
        isTorchOn = !isTorchOn;
        await track.applyConstraints({ advanced: [{ torch: isTorchOn }] });
        btnFlash.classList.toggle("active", isTorchOn);
      } catch (e) {
        console.warn("Torch failed", e);
      }
    });

    // Switch Front / Rear Camera
    btnSwitchCam.addEventListener("click", () => {
      state.facingMode = state.facingMode === "user" ? "environment" : "user";
      startCamera();
    });

    // --- Timer Handling ---
    btnTimer.addEventListener("click", () => {
      const timerStates = [0, 3, 10];
      const nextIdx = (timerStates.indexOf(state.timerSeconds) + 1) % timerStates.length;
      state.timerSeconds = timerStates[nextIdx];
      timerLabel.innerText = `${state.timerSeconds}s`;
    });

    shutterBtn.addEventListener("click", () => {
      if (state.mode === "photo") {
        executeWithTimer(() => capturePhoto());
      } else {
        toggleVideoRecording();
      }
    });

    function executeWithTimer(action) {
      if (state.timerSeconds === 0) {
        action();
        return;
      }

      let count = state.timerSeconds;
      countdownOverlay.innerText = count;
      countdownOverlay.classList.remove("hidden");

      const interval = setInterval(() => {
        count--;
        if (count > 0) {
          countdownOverlay.innerText = count;
        } else {
          clearInterval(interval);
          countdownOverlay.classList.add("hidden");
          action();
        }
      }, 1000);
    }

    // --- Capture Still Photo ---
    async function capturePhoto() {
      playShutterSound();

      const canvas = document.createElement("canvas");
      canvas.width = videoPreview.videoWidth || 1280;
      canvas.height = videoPreview.videoHeight || 720;
      const ctx = canvas.getContext("2d");

      if (state.facingMode === "user") {
        ctx.translate(canvas.width, 0);
        ctx.scale(-1, 1);
      }

      ctx.drawImage(videoPreview, 0, 0, canvas.width, canvas.height);

      canvas.toBlob(async (blob) => {
        const id = await db.saveMedia(blob, "image");
        updateLatestThumbnail();
        openMediaInEditor(id, blob, "image");
      }, "image/jpeg", 0.95);
    }

    // --- Video Recording Handlers ---
    function toggleVideoRecording() {
      if (!state.isRecording) {
        startRecording();
      } else {
        stopRecording();
      }
    }

    function startRecording() {
      state.recordedChunks = [];
      const options = { mimeType: "video/webm;codecs=vp9,opus" };
      const safeOptions = MediaRecorder.isTypeSupported(options.mimeType) ? options : undefined;

      try {
        state.mediaRecorder = new MediaRecorder(state.stream, safeOptions);
      } catch (e) {
        alert("আপনার ব্রাউজারে MediaRecorder সমর্থিত নয়।");
        return;
      }

      state.mediaRecorder.ondataavailable = (e) => {
        if (e.data && e.data.size > 0) state.recordedChunks.push(e.data);
      };

      state.mediaRecorder.onstop = async () => {
        const blob = new Blob(state.recordedChunks, { type: "video/mp4" });
        const id = await db.saveMedia(blob, "video");
        updateLatestThumbnail();
        openMediaInEditor(id, blob, "video");
      };

      state.mediaRecorder.start();
      state.isRecording = true;
      shutterBtn.classList.add("recording");
      recordingIndicator.classList.remove("hidden");

      let elapsed = 0;
      recTimeDisplay.innerText = "00:00";
      state.timerInterval = setInterval(() => {
        elapsed++;
        const mins = String(Math.floor(elapsed / 60)).padStart(2, "0");
        const secs = String(elapsed % 60).padStart(2, "0");
        recTimeDisplay.innerText = `${mins}:${secs}`;
      }, 1000);
    }

    function stopRecording() {
      if (state.mediaRecorder && state.isRecording) {
        state.mediaRecorder.stop();
        state.isRecording = false;
        clearInterval(state.timerInterval);
        shutterBtn.classList.remove("recording");
        recordingIndicator.classList.add("hidden");
      }
    }

    // --- Screen Transitions ---
    function switchScreen(targetScreen) {
      [cameraScreen, galleryScreen, editorScreen].forEach((sc) => sc.classList.remove("active"));
      targetScreen.classList.add("active");

      if (targetScreen !== cameraScreen) {
        stopCamera();
      } else {
        startCamera();
      }
    }

    // Grid Toggle
    btnGrid.addEventListener("click", () => {
      gridOverlay.classList.toggle("hidden");
      btnGrid.classList.toggle("active");
    });

    // Mode Switches
    document.querySelectorAll(".mode-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        document.querySelectorAll(".mode-btn").forEach((b) => b.classList.remove("active"));
        e.target.classList.add("active");
        state.mode = e.target.dataset.mode;
        shutterBtn.className = `shutter-btn ${state.mode}-mode`;
        startCamera();
      });
    });

    // --- Gallery Workflow ---
    document.getElementById("btnOpenGallery").addEventListener("click", async () => {
      await renderGallery();
      switchScreen(galleryScreen);
    });

    document.getElementById("btnBackFromGallery").addEventListener("click", () => {
      switchScreen(cameraScreen);
    });

    async function renderGallery() {
      const container = document.getElementById("galleryGrid");
      const emptyState = document.getElementById("galleryEmptyState");
      container.innerHTML = "";

      const items = await db.getAllMedia();
      if (items.length === 0) {
        emptyState.classList.remove("hidden");
        return;
      }
      emptyState.classList.add("hidden");

      items.forEach((item) => {
        const el = document.createElement("div");
        el.className = "grid-item";
        const mediaUrl = URL.createObjectURL(item.blob);

        if (item.type === "image") {
          el.innerHTML = `<img src="${mediaUrl}" loading="lazy">`;
        } else {
          el.innerHTML = `
            <video src="${mediaUrl}#t=0.5"></video>
            <span class="material-symbols-outlined video-badge">play_arrow</span>
          `;
        }

        el.onclick = () => openMediaInEditor(item.id, item.blob, item.type);
        container.appendChild(el);
      });
    }

    async function updateLatestThumbnail() {
      const items = await db.getAllMedia();
      if (items.length > 0) {
        const latest = items[0];
        const url = URL.createObjectURL(latest.blob);
        galleryThumbPreview.innerHTML = latest.type === "image" 
          ? `<img src="${url}">` 
          : `<span class="material-symbols-outlined">movie</span>`;
      }
    }

    // --- Photo Editor Workflow ---
    function openMediaInEditor(id, blob, type) {
      state.currentMediaItem = { id, blob, type };
      state.rotation = 0;
      state.activeFilter = "none";

      const url = URL.createObjectURL(blob);
      const isImage = type === "image";

      document.getElementById("imageEditControls").classList.toggle("hidden", !isImage);
      document.getElementById("mediaTitle").innerText = isImage ? "ছবি প্রিভিউ ও এডিট" : "ভিডিও প্রিভিউ";

      if (isImage) {
        editorImage.src = url;
        editorImage.classList.remove("hidden");
        editorImage.style.transform = `rotate(0deg)`;
        editorImage.style.filter = "none";
        editorVideo.classList.add("hidden");
        editorVideo.pause();
      } else {
        editorVideo.src = url;
        editorVideo.classList.remove("hidden");
        editorImage.classList.add("hidden");
      }

      switchScreen(editorScreen);
    }

    document.getElementById("btnBackFromEditor").addEventListener("click", () => {
      switchScreen(cameraScreen);
    });

    // Download Button
    document.getElementById("btnDownloadCurrent").addEventListener("click", () => {
      if (!state.currentMediaItem) return;
      const link = document.createElement("a");
      link.href = URL.createObjectURL(state.currentMediaItem.blob);
      link.download = `SmartCamera_${Date.now()}.${state.currentMediaItem.type === "image" ? "jpg" : "mp4"}`;
      link.click();
    });

    // Delete Button
    document.getElementById("btnDeleteCurrent").addEventListener("click", async () => {
      if (!state.currentMediaItem) return;
      if (confirm("আপনি কি নিশ্চিতভাবে এই ফাইলটি মুছে ফেলতে চান?")) {
        await db.deleteMedia(state.currentMediaItem.id);
        updateLatestThumbnail();
        await renderGallery();
        switchScreen(galleryScreen);
      }
    });

    // Filters
    filterChips.forEach((chip) => {
      chip.addEventListener("click", (e) => {
        filterChips.forEach((c) => c.classList.remove("active"));
        e.target.classList.add("active");
        state.activeFilter = e.target.dataset.filter;
        editorImage.style.filter = state.activeFilter;
      });
    });

    // Rotate
    document.getElementById("btnRotate").addEventListener("click", () => {
      state.rotation = (state.rotation + 90) % 360;
      editorImage.style.transform = `rotate(${state.rotation}deg)`;
    });

    // Save Edited Canvas
    document.getElementById("btnSaveEdited").addEventListener("click", () => {
      applyEditsAndSave();
    });

    function applyEditsAndSave(customText = null) {
      const img = new Image();
      img.src = editorImage.src;
      img.onload = async () => {
        const isSideways = state.rotation === 90 || state.rotation === 270;
        editCanvas.width = isSideways ? img.height : img.width;
        editCanvas.height = isSideways ? img.width : img.height;

        const ctx = editCanvas.getContext("2d");
        ctx.filter = state.activeFilter;

        ctx.translate(editCanvas.width / 2, editCanvas.height / 2);
        ctx.rotate((state.rotation * Math.PI) / 180);
        ctx.drawImage(img, -img.width / 2, -img.height / 2);

        if (customText) {
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.font = `bold ${Math.floor(editCanvas.width * 0.05)}px sans-serif`;
          ctx.fillStyle = "rgba(255, 204, 0, 0.95)";
          ctx.shadowColor = "black";
          ctx.shadowBlur = 8;
          ctx.fillText(customText, 30, editCanvas.height - 40);
        }

        editCanvas.toBlob(async (blob) => {
          const newId = await db.saveMedia(blob, "image");
          alert("এডিটেড ছবিটি সফলভাবে সেভ করা হয়েছে!");
          openMediaInEditor(newId, blob, "image");
          updateLatestThumbnail();
        }, "image/jpeg", 0.92);
      };
    }

    // Add Text Prompt
    document.getElementById("btnAddText").addEventListener("click", () => {
      const text = prompt("ছবিতে যুক্ত করার জন্য টেক্সট লিখুন:");
      if (text) {
        applyEditsAndSave(text);
      }
    });

    // --- Settings Modal & Theme Config ---
    const settingsModal = document.getElementById("settingsModal");
    document.getElementById("btnSettings").addEventListener("click", () => {
      settingsModal.classList.remove("hidden");
    });
    document.getElementById("btnCloseSettings").addEventListener("click", () => {
      settingsModal.classList.add("hidden");
    });

    document.getElementById("themeToggle").addEventListener("change", (e) => {
      document.body.className = `${e.target.value}-theme`;
      localStorage.setItem("cam_theme", e.target.value);
    });

    document.getElementById("resolutionSelect").addEventListener("change", (e) => {
      state.settings.resolution = e.target.value;
      startCamera();
    });

    document.getElementById("soundToggle").addEventListener("change", (e) => {
      state.settings.sound = e.target.checked;
    });

    document.getElementById("btnRetryPermission").addEventListener("click", () => {
      startCamera();
    });

    // --- Application Startup ---
    window.addEventListener("DOMContentLoaded", async () => {
      await db.init();
      const savedTheme = localStorage.getItem("cam_theme") || "dark";
      document.body.className = `${savedTheme}-theme`;
      document.getElementById("themeToggle").value = savedTheme;

      updateLatestThumbnail();
      startCamera();
    });

    // Pause stream if minimized to save battery
    window.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopCamera();
      } else if (cameraScreen.classList.contains("active")) {
        startCamera();
      }
    });
  </script>
</body>
</html>
